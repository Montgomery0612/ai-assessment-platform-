# Copy this file to .env.local for local development, or set these as
# Cloudflare secrets before deploying (`npx wrangler secret put ADMIN_ACCOUNTS`).

# Multi-account: a JSON array of { "email", "password" } objects. When set,
# this takes precedence over ADMIN_EMAIL / ADMIN_PASSWORD below.
ADMIN_ACCOUNTS=[{"email":"monty_2025@sjtu.edu.cn","password":"change-me"},{"email":"admin","password":"change-me"}]

# Single-account fallback (used only when ADMIN_ACCOUNTS is not set).
ADMIN_EMAIL=monty_2025@sjtu.edu.cn
ADMIN_PASSWORD=change-me

# Long random string used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
